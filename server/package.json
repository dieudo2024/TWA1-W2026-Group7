    "verify:data": "node scripts/verifyImport.js"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^7.8.9"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
