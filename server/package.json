{
  "name": "airbnb-server",
  "version": "1.0.0",
  "description": "Server for Airbnb Listing Explorer and Review Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "import:data": "node scripts/importAirbnbDataset.js",
